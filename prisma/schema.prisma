generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
  OWNER
}

enum ProjectStatus {
  DISCOVERY
  PLANNING
  DESIGN
  DEVELOPMENT
  VALIDATION
  LIVE
  PAUSED
  COMPLETED
}

enum ConversationChannel {
  WEB
  WHATSAPP
}

enum ConversationStatus {
  AI_ACTIVE
  HUMAN_ACTIVE
  WAITING
  CLOSED
}

enum MessageRole {
  USER
  ASSISTANT
  AGENT
  SYSTEM
  TOOL
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum KnowledgeVisibility {
  PUBLIC
  CUSTOMER
  PROJECT_PRIVATE
  INTERNAL
}

enum PendingActionType {
  CREATE_SUPPORT_TICKET
}

model User {
  id                 String                    @id @default(cuid())
  email              String                    @unique
  phone              String?                   @unique
  name               String
  passwordHash       String?
  role               UserRole                  @default(CUSTOMER)
  emailVerifiedAt    DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  sessions           Session[]
  memberships        OrganizationMember[]
  projectMemberships ProjectMember[]
  conversations      ConversationParticipant[]
  supportTickets     SupportTicket[]
  auditLogs          AuditLog[]                @relation("AuditActor")
  channelConnections ChannelConnection[]
  channelLinkCodes   ChannelLinkCode[]
  pendingActions     PendingAction[]
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model Organization {
  id             String               @id @default(cuid())
  name           String
  slug           String               @unique
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  members        OrganizationMember[]
  contacts       Contact[]
  projects       Project[]
  conversations  Conversation[]
  supportTickets SupportTicket[]
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           UserRole     @default(CUSTOMER)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Contact {
  id             String        @id @default(cuid())
  organizationId String?
  name           String
  email          String?
  phone          String?
  company        String?
  source         String?
  consentAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  leads          Lead[]
  conversations  Conversation[]

  @@index([email])
  @@index([phone])
}

model Lead {
  id          String   @id @default(cuid())
  contactId   String
  title       String
  description String
  service     String?
  budget      Int?
  status      String   @default("NEW")
  source      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model Project {
  id             String              @id @default(cuid())
  organizationId String
  name           String
  slug           String              @unique
  description    String?
  status         ProjectStatus       @default(DISCOVERY)
  progress       Int                 @default(0)
  startedAt      DateTime?
  targetDate     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        ProjectMember[]
  conversations  Conversation[]
  supportTickets SupportTicket[]
  knowledge      KnowledgeDocument[]

  @@index([organizationId, status])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      UserRole @default(CUSTOMER)
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Conversation {
  id             String                    @id @default(cuid())
  organizationId String?
  projectId      String?
  contactId      String?
  channel        ConversationChannel
  externalId     String?
  status         ConversationStatus        @default(AI_ACTIVE)
  assignedUserId String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  closedAt       DateTime?
  organization   Organization?             @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  project        Project?                  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  contact        Contact?                  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  participants   ConversationParticipant[]
  messages       Message[]
  supportTickets SupportTicket[]
  pendingActions PendingAction[]

  @@unique([channel, externalId])
  @@index([organizationId, updatedAt])
  @@index([status, updatedAt])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  leftAt         DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  externalId     String?
  role           MessageRole
  content        String
  metadata       Json?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, externalId])
  @@index([conversationId, createdAt])
}

model ChannelConnection {
  id               String              @id @default(cuid())
  userId           String?
  channel          ConversationChannel
  externalIdentity String
  verifiedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  user             User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([channel, externalIdentity])
  @@index([userId])
}

model ChannelLinkCode {
  id         String              @id @default(cuid())
  userId     String
  channel    ConversationChannel
  codeHash   String              @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime            @default(now())
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, channel, expiresAt])
  @@index([expiresAt, consumedAt])
}

model PendingAction {
  id             String            @id @default(cuid())
  userId         String
  conversationId String
  actionType     PendingActionType
  tokenHash      String            @unique
  payload        Json
  expiresAt      DateTime
  confirmedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime          @default(now())
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([conversationId, expiresAt])
  @@index([expiresAt, confirmedAt, cancelledAt])
}

model SupportTicket {
  id             String         @id @default(cuid())
  organizationId String?
  projectId      String?
  conversationId String?
  requesterId    String
  title          String
  description    String
  status         TicketStatus   @default(OPEN)
  priority       TicketPriority @default(NORMAL)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  resolvedAt     DateTime?
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  project        Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  conversation   Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  requester      User           @relation(fields: [requesterId], references: [id], onDelete: Restrict)

  @@index([status, priority, createdAt])
  @@index([projectId])
}

model KnowledgeDocument {
  id         String              @id @default(cuid())
  projectId  String?
  title      String
  slug       String              @unique
  content    String
  visibility KnowledgeVisibility @default(PUBLIC)
  metadata   Json?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  project    Project?            @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([visibility, updatedAt])
}

model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  externalId  String
  eventType   String
  payload     Json
  processedAt DateTime?
  failedAt    DateTime?
  createdAt   DateTime @default(now())

  @@unique([provider, externalId])
  @@index([provider, processedAt, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model RateLimitBucket {
  id          String   @id @default(cuid())
  identityHash String
  scope       String
  windowStart DateTime
  count       Int      @default(1)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([identityHash, scope, windowStart])
  @@index([expiresAt])
}
